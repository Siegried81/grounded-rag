# Keep secrets, local environments and generated state out of the build context
# and the image. Indexes, the embedding cache (inside index/) and logs are
# runtime state and live in Docker volumes instead.
.env
.env.*
!.env.example
.venv/
venv/
index/
cache/
logs/
.git/
.gitignore
**/__pycache__/
**/*.pyc
.pytest_cache/
.streamlit/secrets.toml
# The corpora (11 MB of text) travel in the image: a platform without a bind
# mount (Render) builds the indexes at start from them. docker-compose.yml
# still mounts ./data read-only over them, so local edits win there.
Dockerfile
docker-compose.yml
.dockerignore
# The React UI is built on the host; only web/dist is useful in the image.
web/node_modules/
