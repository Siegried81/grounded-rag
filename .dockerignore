# Keep secrets, local environments and generated state out of the build context
# and the image. Indexes, the embedding cache (inside index/) and logs are
# runtime state and live in Docker volumes instead.
.env
.env.*
!.env.example
.venv/
venv/
index/
cache/
logs/
.git/
.gitignore
**/__pycache__/
**/*.pyc
.pytest_cache/
.streamlit/secrets.toml
# Private working files that git ignores (some only through .git/info/exclude,
# which Docker never reads). `COPY . .` would carry them into an image built
# from a local checkout, and that image has the Docker Hub name. The only
# text files the image needs at the root are the requirements lists.
_build/
*.txt
# red-teaming.docx is a private working document (excluded from git locally).
*.docx
# Named one by one: an exception with a wildcard makes the builder walk every
# excluded folder to look for a match, including ones it is not allowed to open.
!requirements.txt
!requirements-dev.txt
!requirements-optional.txt
# The corpora (under 1 MB of text) travel in the image: a platform without a bind
# mount (Render) builds the indexes at start from them. docker-compose.yml
# still mounts ./data read-only over them, so local edits win there.
Dockerfile
docker-compose.yml
.dockerignore
# The raw SEC submission (9.5 MB, data/filings/raw/) is provenance only: the
# indexes are built from data/filings_sections/ and data/filings_statements/,
# never from this file.
data/filings/raw/
# The React UI is built on the host; only web/dist is useful in the image.
web/node_modules/
