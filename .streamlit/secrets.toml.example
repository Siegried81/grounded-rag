# Template for Streamlit Community Cloud: paste this, with real values, into the
# app's Settings -> Secrets. Locally, use .env instead (see .env.example).
# The real .streamlit/secrets.toml is gitignored; never put real keys here.
#
# Keep every key at the top level, outside any [section]: Streamlit exports only
# top-level keys as environment variables, and config.py reads environment
# variables, not st.secrets.

# --- Embeddings ---------------------------------------------------------------
# Groq serves no embeddings endpoint, so this is a second provider's key.
EMBED_PROVIDER = "hosted"
HOSTED_EMBED_BASE_URL = "https://api.mistral.ai/v1"   # any OpenAI-compatible /embeddings endpoint
HOSTED_EMBED_MODEL = "mistral-embed"
HOSTED_EMBED_API_KEY = "your_key_here"

# --- Generation ---------------------------------------------------------------
GROQ_API_KEY = "your_key_here"
# Optional: extra Groq keys, used in turn when one is rate-limited.
# GROQ_API_KEY_2 = ""
# GROQ_API_KEY_3 = ""

# --- Index --------------------------------------------------------------------
# The cloud has no persistent disk, so the app rebuilds these corpora's index on
# a cold start. Without it the app shows "No indexed corpus found".
AUTO_INGEST = "ai_act_sections,filings_sections"
