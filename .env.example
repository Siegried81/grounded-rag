# Copy to .env and fill in. .env is gitignored; NEVER put real keys in this example.

# --- Embeddings: ollama (local, default) | hosted | azure_openai | sentence_transformers | fake
EMBED_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
# For EMBED_PROVIDER=hosted (any OpenAI-compatible /v1/embeddings endpoint):
# HOSTED_EMBED_BASE_URL=https://api.example.com/v1
# HOSTED_EMBED_MODEL=text-embedding-3-small
# HOSTED_EMBED_API_KEY=your_key_here

# --- Generation: groq (default) | openrouter | huggingface | azure_openai | ollama
LLM_PROVIDER=groq
# true (default): fall back to the next provider when this one fails, so the app
# keeps answering. false: every call goes to LLM_PROVIDER only; use it for an
# evaluation, so one run measures one model.
LLM_FALLBACK=true
# Up to five Groq keys; the client rotates to the next when one is rate-limited.
# Only GROQ_API_KEY is required; _2.._5 are optional and multiply the free quota.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Hugging Face Inference Providers (paid from the account's credits). Setting
# HF_TOKEN adds it to the fallback chain, before Ollama.
HF_TOKEN=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
OLLAMA_LLM_MODEL=llama3.2:3b
# Azure OpenAI (docs/azure.md): one resource for LLM_PROVIDER=azure_openai and
# EMBED_PROVIDER=azure_openai. The deployments are the names you chose in the
# portal. Setting the key adds Azure to the fallback chain, before Ollama.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_EMBED_DEPLOYMENT=
# AZURE_OPENAI_EMBED_BATCH=64

# --- Retrieval / ingestion (optional; defaults live in config.py) ------------
# RETRIEVAL_MODE=hybrid        # hybrid | dense
# CANDIDATE_K=20
# TOP_K=5
# SCORE_THRESHOLD=0.35
# USE_MMR=true
# MMR_LAMBDA=0.6
# VECTOR_INDEX=numpy           # numpy (exact, default) | faiss | qdrant | azure_search (approximate)
# FAISS_EF_SEARCH=64
# QDRANT_URL=http://localhost:6333   # only for VECTOR_INDEX=qdrant
# QDRANT_COLLECTION=grounded_rag     # only for VECTOR_INDEX=qdrant; a prefix: one collection per corpus, <prefix>_<corpus>
# QDRANT_API_KEY=                    # only for a managed server (Qdrant Cloud); leave empty for a local one
# AZURE_SEARCH_ENDPOINT=             # only for VECTOR_INDEX=azure_search: https://<service>.search.windows.net
# AZURE_SEARCH_API_KEY=              # an ADMIN key: the backend creates the index and uploads the vectors
# AZURE_SEARCH_INDEX=grounded-rag    # a prefix: one index per corpus, <prefix>-<corpus>
# RERANKER=none                # none | cross_encoder (requirements-optional.txt)
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# CHUNKER=smart                # smart | char
# USE_EMBED_CACHE=true
# INCREMENTAL_INGEST=false     # true: only re-chunk/re-embed new or changed files
# VERIFY_MIN_GROUNDING=0.30
# NLI_CHECK=false              # true: NLI entailment per cited sentence (requirements-optional.txt)
# NLI_MODEL=cross-encoder/nli-deberta-v3-xsmall
# USER_TURN_GUARD=false        # true: fence the user question too (closes leak-02/jb-03); changes the prompt

# Free-tier protections (rag/llm.py): wait for the Groq rate-limit window
# before falling back (seconds, 0 = fall back at once), and cache completions.
GROQ_MAX_WAIT_S=65
LLM_CACHE=1

# Default answer language in the UIs: auto | en | fr | nl. "auto" lets the model
# follow the question and sources; the evaluation scripts ignore this setting.
ANSWER_LANGUAGE=en

# Show answers in the UIs while the model writes them (server-sent events).
# Same answer and same verification either way; false waits for the whole text.
# STREAM_ANSWERS=true
