# --- Embeddings: ollama (local, default) | hosted | fake ---------------------
EMBED_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
# For EMBED_PROVIDER=hosted (any OpenAI-compatible /v1/embeddings endpoint):
# HOSTED_EMBED_BASE_URL=https://api.example.com/v1
# HOSTED_EMBED_MODEL=text-embedding-3-small
# HOSTED_EMBED_API_KEY=your_key_here

# --- Generation: groq (default) | openrouter | ollama ------------------------
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OLLAMA_LLM_MODEL=llama3.2:3b

# --- Tunables (optional; defaults live in config.py) -------------------------
# CHUNK_SIZE=900
# CHUNK_OVERLAP=150
# TOP_K=5
# SCORE_THRESHOLD=0.35
